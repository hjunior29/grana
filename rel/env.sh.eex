#!/bin/sh

# Nó local fixo: o Grana roda em uma única máquina e o `bin/grana stop|eval|remote`
# precisa achar o nó sem depender da resolução do hostname.
export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-name}"
export RELEASE_NODE="${RELEASE_NODE:-<%= @release.name %>@127.0.0.1}"

# Cookie por instalação, nunca o gerado no build.
COOKIE_FILE="${DATA_DIR:-/var/lib/grana}/secrets/release_cookie"
if [ -z "${RELEASE_COOKIE:-}" ]; then
  if [ ! -s "$COOKIE_FILE" ]; then
    mkdir -p "$(dirname "$COOKIE_FILE")" && chmod 700 "$(dirname "$COOKIE_FILE")"
    (umask 077; head -c 48 /dev/urandom | base64 | tr -d '\n=/+' > "$COOKIE_FILE")
  fi
  RELEASE_COOKIE="$(cat "$COOKIE_FILE")"
fi
export RELEASE_COOKIE
export ERL_EPMD_ADDRESS="${ERL_EPMD_ADDRESS:-127.0.0.1}"
